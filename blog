<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #FFFFFF; --bg2: #F8F9FA; --bg3: #F1F3F5;
  --surface: rgba(0,0,0,0.03); --surface-h: rgba(0,0,0,0.06);
  --border: rgba(180,145,30,0.2); --border2: rgba(180,145,30,0.4);
  --tx: #1A1A2E; --tx2: rgba(26,26,46,0.7); --tx3: rgba(26,26,46,0.45);
  --gold: #B8860B; --gold-dim: rgba(184,134,11,0.08); --gold-glow: rgba(184,134,11,0.2);
  --gr: #16a34a; --gr-l: rgba(22,163,74,0.08); --gr-border: rgba(22,163,74,0.3);
  --rd: #dc2626; --rd-l: rgba(220,38,38,0.08); --rd-border: rgba(220,38,38,0.25);
  --or: #ea580c; --or-l: rgba(234,88,12,0.08); --or-border: rgba(234,88,12,0.3);
  --bl: #2563eb; --bl-l: rgba(37,99,235,0.08); --bl-border: rgba(37,99,235,0.25);
  --pu: #7c3aed; --pu-l: rgba(124,58,237,0.08); --pu-border: rgba(124,58,237,0.25);
  --font: 'Plus Jakarta Sans', sans-serif;
  --display: 'Cormorant Garamond', serif;
  --mono: 'JetBrains Mono', monospace;
}
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font); background: var(--bg); color: var(--tx);
  line-height: 1.7; -webkit-font-smoothing: antialiased; overflow-x: hidden;
  background-image: radial-gradient(ellipse 80% 40% at 50% -10%, rgba(184,134,11,0.04) 0%, transparent 60%);
  background-attachment: fixed;
}
body::after { display: none; }

.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }

/* HEADER */
header {
  background: rgba(255,255,255,0.98); backdrop-filter: blur(20px); box-shadow: 0 2px 20px rgba(0,0,0,0.08);
  border-bottom: 1px solid var(--border); padding: 48px 0; text-align: center;
  position: relative; overflow: hidden;
}
header::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 60% 100% at 50% 0%, rgba(212,175,55,0.07) 0%, transparent 70%);
}
header::after { display: none; }
.logo {
  font-family: var(--display); font-size: clamp(28px, 5vw, 42px);
  font-weight: 700; color: var(--gold);
  margin-bottom: 12px; letter-spacing: 1px;
  position: relative; z-index: 1;
  text-shadow: 0 0 40px rgba(212,175,55,0.3);
}
.tagline { font-size: 14px; color: var(--tx3); letter-spacing: 1px; position: relative; z-index: 1; }
header p:last-child { font-size: 13px; color: var(--tx3); margin-top: 10px; position: relative; z-index: 1; }
.gold-line { height: 1px; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent); }

/* HERO */
.hero {
  padding: 60px 0; text-align: center;
  border-bottom: 1px solid var(--border); margin-bottom: 48px;
  position: relative; overflow: hidden;
}
.hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 50% 80% at 50% 50%, rgba(212,175,55,0.04) 0%, transparent 70%);
}
.hero h1 {
  font-family: var(--display); font-size: clamp(32px, 5vw, 52px);
  font-weight: 700; color: var(--tx); margin-bottom: 16px; position: relative;
}
.hero p { font-size: 16px; color: var(--tx2); position: relative; }
.hero-status {
  margin-top: 24px; padding: 16px 24px;
  background: var(--gr-l); border: 1px solid var(--gr-border);
  border-radius: 12px; font-weight: 700; font-size: 14px; color: var(--gr);
  display: inline-block; position: relative;
}

/* TRIBUTE */
.tribute-banner {
  background: linear-gradient(135deg, rgba(184,134,11,0.06) 0%, rgba(248,249,250,0.9) 100%);
  border: 1px solid var(--border2); border-left: 4px solid var(--gold);
  border-radius: 0 16px 16px 0; padding: 32px 40px; margin-bottom: 40px;
  position: relative; overflow: hidden;
}
.tribute-banner::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.3), transparent); }
.tribute-banner h3 { font-family: var(--display); color: var(--gold); margin-bottom: 14px; font-size: 22px; }
.tribute-banner p { color: var(--tx2); margin: 6px 0; font-size: 14px; }
.tribute-quote {
  margin-top: 20px; padding: 16px 20px;
  background: rgba(212,175,55,0.07); border-radius: 10px;
  font-style: italic; font-size: 15px; color: var(--gold); border-left: 3px solid var(--gold);
}

/* STATUS NOW */
.status-now {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 20px; padding: 40px; margin-bottom: 48px;
  position: relative; overflow: hidden;
}
.status-now::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent); }
.status-now h2 { font-family: var(--display); color: var(--gold); margin-bottom: 8px; font-size: 28px; }
.status-now > p { color: var(--tx3); font-size: 13px; margin-bottom: 24px; }
.status-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap: 16px; }
.status-item {
  background: rgba(255,255,255,0.8); border: 1px solid var(--border);
  border-radius: 12px; padding: 18px 20px; transition: border-color .2s;
}
.status-item:hover { border-color: var(--border2); }
.status-item .s-title { font-weight: 700; font-size: 13px; margin-bottom: 8px; color: var(--tx); }
.status-item .s-desc { font-size: 12px; color: var(--tx3); line-height: 1.6; }
.s-green { border-left: 3px solid var(--gr) !important; }
.s-orange { border-left: 3px solid var(--or) !important; }
.s-yellow { border-left: 3px solid var(--gold) !important; }
.s-blue { border-left: 3px solid var(--bl) !important; }
.s-purple { border-left: 3px solid var(--pu) !important; }
.s-red { border-left: 3px solid var(--rd) !important; }

/* SECTION TITLE */
.section-title {
  font-family: var(--display); font-size: clamp(24px, 4vw, 36px);
  color: var(--tx); border-left: 4px solid var(--gold);
  padding-left: 20px; margin: 60px 0 32px;
}

/* CARDS */
.card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 48px; }
.card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 16px; padding: 28px; transition: all .25s;
  position: relative; overflow: hidden;
}
.card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.15), transparent); }
.card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.4); border-color: var(--border2); background: var(--surface-h); }
.card.princess { border-top: 3px solid var(--pu); }
.card.pilot { border-top: 3px solid var(--bl); }
.card.gemini { border-top: 3px solid var(--gold); }
.card.director { border-top: 3px solid #10b981; }
.card.skywork { border-top: 3px solid var(--rd); opacity: 0.75; }
.card.winner { border-top: 3px solid #F59E0B; }
.card.completed { border-top: 3px solid var(--gr); }
.card h3 { font-family: var(--display); margin-top: 0; color: var(--gold); font-size: 22px; margin-bottom: 12px; }
.card .emoji { font-size: 2.5em; margin-bottom: 14px; display: block; }
.card p { font-size: 13px; color: var(--tx2); margin-bottom: 8px; }
.card ul { padding-left: 18px; }
.card ul li { font-size: 13px; color: var(--tx2); margin-bottom: 4px; }
.card .date { font-size: 11px; color: var(--tx3); font-style: italic; margin-top: 12px; }
.card strong { color: var(--tx); }

.status-badge {
  display: inline-block; padding: 4px 14px; border-radius: 100px;
  font-size: 11px; font-weight: 700; margin-top: 12px; letter-spacing: 0.5px;
}
.status-badge.completed { background: var(--gr-l); color: var(--gr); border: 1px solid var(--gr-border); }
.status-badge.active { background: var(--bl-l); color: var(--bl); border: 1px solid var(--bl-border); }
.status-badge.pending { background: var(--gold-dim); color: var(--gold); border: 1px solid var(--border2); }
.status-badge.building { background: var(--or-l); color: var(--or); border: 1px solid var(--or-border); }
.status-badge.dead { background: var(--rd-l); color: var(--rd); border: 1px solid var(--rd-border); }

/* DIRECTOR NOTE */
.director-note {
  background: rgba(251,146,60,0.06); border: 1px solid var(--or-border);
  border-left: 3px solid var(--or); border-radius: 10px;
  padding: 12px 16px; margin-top: 14px; font-size: 12px; color: var(--tx2);
}
.winner-note {
  background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.3);
  border-left: 3px solid #F59E0B; border-radius: 10px;
  padding: 12px 16px; margin-top: 14px; font-size: 12px; color: var(--tx2);
}
.rip-note {
  background: var(--rd-l); border: 1px solid var(--rd-border);
  border-left: 3px solid var(--rd); border-radius: 10px;
  padding: 12px 16px; margin-top: 14px; font-size: 12px; color: var(--rd);
}

/* TIMELINE */
.timeline { position: relative; padding-left: 40px; margin: 40px 0; }
.timeline::before {
  content: ''; position: absolute; left: 15px; top: 0; bottom: 0; width: 2px;
  background: linear-gradient(to bottom, var(--gold), rgba(212,175,55,0.1));
}
.timeline-item { position: relative; padding-bottom: 32px; }
.timeline-item::before {
  content: ''; position: absolute; left: -32px; top: 6px;
  width: 14px; height: 14px; border-radius: 50%;
  background: var(--gold); border: 2px solid var(--bg);
  box-shadow: 0 0 0 2px var(--gold);
}
.timeline-item.completed::before { background: var(--gr); box-shadow: 0 0 0 2px var(--gr); }
.timeline-item.active::before {
  background: var(--or); box-shadow: 0 0 0 2px var(--or);
  animation: tl-pulse 2s infinite;
}
@keyframes tl-pulse { 0%,100%{box-shadow:0 0 0 2px var(--or)} 50%{box-shadow:0 0 0 6px rgba(251,146,60,0.2)} }
.timeline-item h3 { font-family: var(--display); font-size: 20px; color: var(--gold); margin-bottom: 8px; }
.timeline-item p { font-size: 14px; color: var(--tx2); }
.timeline-item ul { padding-left: 18px; margin: 8px 0; }
.timeline-item ul li { font-size: 13px; color: var(--tx2); margin-bottom: 4px; }
.timeline-item strong { color: var(--tx); }

/* CASE STUDY */
.case-study {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 20px; padding: 40px; margin: 24px 0 48px;
  position: relative; overflow: hidden;
}
.case-study::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.2), transparent); }
.case-study h3 { font-family: var(--display); color: var(--bl); font-size: 28px; margin-bottom: 24px; }
.case-study h4 { font-size: 15px; font-weight: 700; margin-bottom: 10px; }
.case-study p { font-size: 14px; color: var(--tx2); margin-bottom: 8px; }
.case-study ul { padding-left: 18px; }
.case-study ul li { font-size: 14px; color: var(--tx2); margin-bottom: 5px; }
.case-study strong { color: var(--tx); }

.cs-problem { background: var(--rd-l); border: 1px solid var(--rd-border); border-left: 3px solid var(--rd); border-radius: 10px; padding: 20px; margin: 16px 0; }
.cs-problem h4 { color: var(--rd); }
.cs-solution { background: var(--gr-l); border: 1px solid var(--gr-border); border-left: 3px solid var(--gr); border-radius: 10px; padding: 20px; margin: 16px 0; }
.cs-solution h4 { color: var(--gr); }
.cs-result { background: var(--bl-l); border: 1px solid var(--bl-border); border-left: 3px solid var(--bl); border-radius: 10px; padding: 20px; margin: 16px 0; }
.cs-result h4 { color: var(--bl); }
.cs-inprogress { background: var(--or-l); border: 1px solid var(--or-border); border-left: 3px solid var(--or); border-radius: 10px; padding: 20px; margin: 16px 0; }
.cs-inprogress h4 { color: var(--or); }

/* BLOG SECTION */
.blog-section {
  text-align: center; margin: 48px 0; padding: 48px 40px;
  background: var(--surface); border: 1px solid var(--border2);
  border-radius: 20px; position: relative; overflow: hidden;
}
.blog-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent); }
.blog-section h2 { font-family: var(--display); color: var(--gold); margin-bottom: 16px; font-size: 32px; }
.blog-section p { font-size: 15px; color: var(--tx2); }
.blog-quote {
  font-style: italic; font-size: 16px; color: var(--tx);
  margin: 24px 0; padding: 24px;
  background: rgba(0,0,0,0.3); border-radius: 12px;
  border-left: 4px solid var(--gold);
  line-height: 2;
}
.blog-quote strong { color: var(--gold); }
.blog-update {
  margin-top: 28px; padding: 20px 24px;
  background: var(--gr-l); border: 1px solid var(--gr-border);
  border-radius: 12px; font-size: 14px; color: var(--tx2); text-align: left;
}
.blog-update strong { color: var(--tx); }
.blog-update em { color: var(--gold); }

/* FOOTER */
footer {
  background: var(--bg2); border-top: 1px solid var(--border);
  color: var(--tx2); text-align: center; padding: 48px 24px; margin-top: 64px;
}
footer p { margin-bottom: 10px; font-size: 14px; }
footer a { color: var(--gold); text-decoration: none; }
footer a:hover { text-decoration: underline; }
.footer-status {
  margin-top: 24px; padding: 20px 24px;
  background: var(--gr-l); border: 1px solid var(--gr-border);
  border-radius: 12px; font-size: 13px; color: var(--tx2);
  max-width: 700px; margin-left: auto; margin-right: auto; text-align: left;
}
.footer-status strong { color: var(--tx); }

@media(max-width: 768px) {
  .logo { font-size: 24px; }
  .hero h1 { font-size: 28px; }
  .section-title { font-size: 22px; }
  .card-grid { grid-template-columns: 1fr; }
  .tribute-banner, .status-now, .case-study, .blog-section { padding: 24px 20px; }
  .timeline { padding-left: 28px; }
}
</style>
</head>
